{
  "clinkPlugins": [
    { "name": "clink-completions", "repo": "https://github.com/vladimir-kotikov/clink-completions" },
    { "name": "clink-gizmos", "repo": "https://github.com/chrisant996/clink-gizmos" }
  ],
  "directories": [
    "D:/SoftwareApps"
  ],
  "gitExtras": {
    "repo": "https://github.com/tj/git-extras.git"
  },
  "scoopBackup": "configs/windows/scoop/backup.json",
  "scoopBackupLite": "configs/windows/scoop/backup.lite.json",
  "profileArtifacts": {
    "lite": "scoopBackupLite",
    "full": "scoopBackup"
  },
  "scoopLiteApps": [
    "7zip",
    "aria2",
    "eza",
    "FiraCode-NF-Mono",
    "fzf",
    "git",
    "starship",
    "winsw-pre",
    "zoxide"
  ],
  "scoopAccel": {
    "installScript": "https://raw.githubusercontent.com/ScoopInstaller/Install/master/install.ps1",
    "scoopRepo": "https://github.com/ScoopInstaller/Scoop",
    "githubHosts": [
      "github.com",
      "raw.githubusercontent.com",
      "objects.githubusercontent.com",
      "release-assets.githubusercontent.com",
      "codeload.github.com"
    ],
    "aria2": {
      "enabled": true,
      "warningEnabled": false,
      "retryWait": 2,
      "split": 16,
      "maxConnectionPerServer": 16,
      "minSplitSize": "1M"
    }
  },
  "scoopDir": "D:\\SoftwareApps\\Scoop",
  "softwareAppsDir": "D:/SoftwareApps",
  "sync": {
    "toRepo": [
      { "local": "~/.zshrc", "repo": "configs/windows/.zshrc", "backup": true },
      { "local": "~/.bashrc", "repo": "configs/windows/.bashrc" },
      { "local": "~/.zsh/functions/utils.zsh", "repo": "configs/windows/utils.zsh" },
      { "local": "~/.zsh/functions/aliases.win.zsh", "repo": "configs/windows/aliases.zsh" },
      { "local": "~/.zsh/functions/scoop.zsh", "repo": "configs/windows/scoop/scoop.zsh" },
      { "local": "D:/SoftwareApps/Scoop/config/scoop.ps1", "repo": "configs/windows/scoop/scoop.ps1", "restoreOnly": true, "encoding": "utf8Bom" },
      { "local": "D:/SoftwareApps/Scoop/config/scoop-services/manifest.json", "repo": "configs/windows/scoop/services/manifest.json" },
      { "local": "D:/SoftwareApps/Scoop/config/scoop-services/manage.ps1", "repo": "scripts/windows/scoop/services/manage.ps1", "restoreOnly": true, "encoding": "utf8Bom" },
      { "local": "D:/SoftwareApps/Scoop/config/scoop-mirror/hook.ps1", "repo": "scripts/windows/scoop/mirror/hook.ps1", "restoreOnly": true, "encoding": "utf8Bom" },
      { "local": "D:/SoftwareApps/Scoop/config/scoop-mirror/shared.ps1", "repo": "scripts/windows/scoop/mirror/shared.ps1", "restoreOnly": true, "encoding": "utf8Bom" },
      { "local": "D:/SoftwareApps/Scoop/config/scoop-mirror/cli.mjs", "repo": "scripts/windows/scoop/mirror/cli.mjs", "restoreOnly": true },
      { "local": "D:/SoftwareApps/Scoop/config/scoop-mirror/lib/menu-select.mjs", "repo": "scripts/lib/menu-select.mjs", "restoreOnly": true },
      { "local": "D:/SoftwareApps/Scoop/config/scoop-mirror/lib/string-width.mjs", "repo": "scripts/lib/string-width.mjs", "restoreOnly": true },
      { "local": "D:/SoftwareApps/Scoop/config/scoop-mirror/lib/tty-term.mjs", "repo": "scripts/lib/tty-term.mjs", "restoreOnly": true },
      { "local": "D:/SoftwareApps/Scoop/persist/clash-party/data/mihomo.yaml", "repo": "configs/common/mihomo.yaml", "lite": false, "defaultSelected": false },
      { "local": "~/Documents/WindowsPowerShell/Microsoft.PowerShell_profile.ps1", "repo": "configs/windows/pwsh5_profile.ps1", "backup": true },
      { "local": "~/Documents/PowerShell/Microsoft.PowerShell_profile.ps1", "repo": "configs/windows/pwsh7_profile.ps1", "backup": true }
    ]
  },
  "zshInstall": {
    "archiveName": "zsh-5.9-4-x86_64.pkg.tar.zst",
    "cpErrorLog": "cp_error.log",
    "downloadUrl": "https://mirror.msys2.org/msys/x86_64/zsh-5.9-4-x86_64.pkg.tar.zst",
    "tempExtractDir": "zsh-temp-extract",
    "workDir": "~/Desktop"
  }
}
