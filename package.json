{
  "name": "use",
  "version": "1.0.0",
  "description": "A tool for managing my development environment",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "pm": "node ./src/cli.js pm",
    "init": "node ./src/cli.js init",
    "backup": "node ./src/cli.js backup",
    "setup": "node ./src/cli.js setup",
    "sync": "node ./src/cli.js sync",
    "zsh": "node ./src/cli.js zsh",
    "zsh-plugin": "node ./src/cli.js zsh-plugin",
    "git-setup": "node ./src/cli.js git-setup",
    "git-extras": "node ./src/cli.js git-extras",
    "clink": "node ./src/cli.js clink",
    "generate:brew": "node ./src/generate/generate-brew.js",
    "check:brew": "node ./src/generate/generate-brew.js --check",
    "generate:github-accel": "node ./src/generate/generate-github-accel.js",
    "check:github-accel": "node ./src/generate/generate-github-accel.js --check",
    "test": "node --test src/**/*.test.js && node ./runtime/brew/mirror.test.mjs && node ./runtime/scoop/mirror/test.mjs && npm run check:brew && npm run check:github-accel"
  },
  "author": "wwlight",
  "license": "ISC",
  "packageManager": "pnpm@10.12.4"
}
