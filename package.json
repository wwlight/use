{
  "name": "use",
  "version": "1.0.0",
  "description": "A tool for managing my development environment",
  "scripts": {
    "pm": "node ./scripts/_dispatch.mjs pm",
    "init": "node ./scripts/_dispatch.mjs init",
    "backup": "node ./scripts/_dispatch.mjs backup",
    "setup": "node ./scripts/_dispatch.mjs setup",
    "sync": "node ./scripts/_dispatch.mjs sync",
    "zsh": "node ./scripts/_dispatch.mjs zsh",
    "zsh-plugin": "node ./scripts/_dispatch.mjs zsh-plugin",
    "git-setup": "node ./scripts/_dispatch.mjs git-setup",
    "git-extras": "node ./scripts/_dispatch.mjs git-extras",
    "clink": "node ./scripts/_dispatch.mjs clink",
    "generate:homebrew": "node ./scripts/lib/generate-homebrew.mjs",
    "check:homebrew": "node ./scripts/lib/generate-homebrew.mjs --check",
    "generate:github-accel": "node ./scripts/lib/generate-github-accel.mjs",
    "check:github-accel": "node ./scripts/lib/generate-github-accel.mjs --check",
    "test": "node ./scripts/lib/menu-select.test.mjs && node ./scripts/lib/manifest-config.test.mjs && node ./scripts/macos/homebrew-generated.test.mjs && node ./scripts/macos/brew-mirror.test.mjs && node ./scripts/windows/scoop/mirror/test.mjs && npm run check:homebrew && npm run check:github-accel"
  },
  "author": "wwlight",
  "license": "ISC",
  "packageManager": "pnpm@10.12.4"
}
