{
  "repo": "https://github.com/wwlight/use.git",
  "directories": [
    "~/.zsh/plugins",
    "~/.zsh/cache",
    "~/.zsh/history",
    "~/.zsh/functions",
    "~/.config/starship"
  ],
  "zshPluginsDir": "~/.zsh/plugins",
  "profiles": {
    "lite": { "label": "尝鲜版" },
    "full": { "label": "完整版" }
  },
  "git": {
    "credentialHelper": "store",
    "defaultBranch": "main",
    "ignorecase": false,
    "safeDirectory": "*"
  },
  "sync": {
    "toRepo": [
      { "local": "~/.zsh/.zshrc_core", "repo": "configs/common/.zshrc_core" },
      { "local": "~/.zsh/functions/aliases.zsh", "repo": "configs/common/aliases.zsh" },
      { "local": "~/.zsh/functions/github-accel.zsh", "repo": "configs/common/github-accel.zsh", "restoreOnly": true },
      { "local": "~/.config/starship/starship.toml", "repo": "configs/common/starship.toml" },
      { "local": "~/.config/opencode", "repo": "configs/common/opencode", "backup": true, "lite": false, "defaultSelected": false, "directory": true, "exclude": ["node_modules", "package.json", "package-lock.json", "bun.lock", ".gitignore", ".DS_Store", "cli.json", "service.json", "tui.json", "vibeguard.config.json"] },
      { "local": "~/.agents/.skill-lock.json", "repo": "configs/common/agents/skill-lock.json", "backup": true, "lite": false },
      { "local": "~/.config/mise/config.toml", "repo": "configs/common/mise.config.toml", "backup": true, "lite": false }
    ]
  },
  "zshPlugins": [
    { "name": "zsh-autocomplete", "repo": "https://github.com/marlonrichert/zsh-autocomplete.git" },
    { "name": "zsh-autosuggestions", "repo": "https://github.com/zsh-users/zsh-autosuggestions.git" },
    { "name": "zsh-syntax-highlighting", "repo": "https://github.com/zsh-users/zsh-syntax-highlighting.git" },
    { "name": "zsh-completions", "repo": "https://github.com/zsh-users/zsh-completions.git" }
  ],
  "githubAccel": {
    "default": "ghproxy",
    "mirrors": [
      { "id": "ghproxy", "prefix": "https://gh-proxy.com/" },
      { "id": "ghproxy-net", "prefix": "https://ghproxy.net/" },
      { "id": "ghfast", "prefix": "https://ghfast.top/" }
    ]
  }
}
